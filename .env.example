# moray-surgeon — docker-compose environment template.
#
#   cp .env.example .env
#   # edit .env, then: docker compose up -d --build
#
# .env holds the model credential. Keep it out of version control (the project
# .gitignore already excludes .env) and chmod 600 it on shared hosts.

# --- Web console -----------------------------------------------------------
# Host bind address. 127.0.0.1 keeps the console off the network; use 0.0.0.0
# only behind a TLS reverse proxy with authentication.
MORAY_BIND_HOST=127.0.0.1
MORAY_PORT=8080
# Host directory mounted as /workspace (absolute, or relative to this file).
MORAY_WORKSPACE=./workspace

# --- Model provider --------------------------------------------------------
# ollama | openai | anthropic
MORAY_API_TYPE=ollama
MORAY_MODEL=qwen2.5-coder:7b
# Local compose Ollama (start with --profile ollama):
MORAY_BASE_URL=http://ollama:11434

# Cloud API examples — uncomment, set the key, and start without --profile:
# MORAY_API_TYPE=openai
# MORAY_BASE_URL=https://api.openai.com/v1
# MORAY_MODEL=gpt-4o-mini
#
# MORAY_API_TYPE=anthropic
# MORAY_BASE_URL=https://api.anthropic.com
# MORAY_MODEL=claude-sonnet-4-5
MORAY_API_KEY=
MORAY_TIMEOUT=120

# --- Engine ----------------------------------------------------------------
# Parallel workers for independent file edits (default min(cpu, 8)).
MORAY_MAX_WORKERS=4

# --- Commit identity -------------------------------------------------------
# The transaction layer commits refactors. Change these to your service account.
MORAY_GIT_NAME=moray-surgeon
MORAY_GIT_EMAIL=moray-surgeon@localhost

# --- Linux bind-mount ownership --------------------------------------------
# Match the host user that owns MORAY_WORKSPACE, then rebuild:
#   MORAY_UID=$(id -u) MORAY_GID=$(id -g) docker compose build
MORAY_UID=1000
MORAY_GID=1000
